# Secrets — never commit. Read via clipforge.config.Secrets (env_file=".env").
.env
.env.*
!.env.example

# Workspace: media, artifacts, state, generated pieces, quota ledger.
workspace/

# Python
.venv/
# LTX-2.5 needs diffusers 0.40 + transformers 5.x, which whisperx's
# huggingface-hub<1.0 pin keeps out of .venv. Second interpreter, not
# a second copy of the project.
.venv-ltx25/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Model weights (fetched, not vendored)
*.pt
*.task
*.safetensors

# PowerShell accident: `... > $null` on Windows creates a literal file
# named $null rather than discarding output (that is `$null = ...` or
# `Out-Null`). One got committed; this keeps the next one out.
$null
